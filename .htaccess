# MiLocalWeb — Landing Page de Cliente
# Reglas de seguridad, caché y rendimiento.

# Sin listados de directorio si falta un index.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ---- Headers de seguridad ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src 'none'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
</IfModule>

# ---- Cache para assets ----
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

<FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

<FilesMatch "\.(webp|png|jpg|jpeg|gif|ico|svg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

<FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# ---- URLs limpias y seguridad básica ----
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear código, documentación interna, metadatos y archivos de trabajo.
    # `_local/` contiene la ficha con datos personales del autor; nunca debe
    # servirse por HTTP. Los PDFs y .txt de productos son privados mientras
    # `libros_pdf_publico` sea false.
    RewriteRule ^(?:config\.php|router\.php|includes|tools|_local|docs|\.git|\.atl)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:AGENTS|README)\.md$ - [F,L,NC]
    RewriteRule ^productos/.*\.(?:pdf|txt|md|docx)$ - [F,L,NC]

    # Alias de dominio: todo host que no sea el canónico (ni local) va 301
    # al dominio principal, en un solo salto.
    RewriteCond %{HTTP_HOST} !^alejandrotinte\.milocalweb\.com\.ar$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://alejandrotinte.milocalweb.com.ar%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Fichas de libro: /libros/{slug} -> libro.php?slug={slug}
    RewriteRule ^libros/([a-z0-9-]+)/?$ libro.php?slug=$1 [L,QSA]

    # /libros sin slug -> sección de libros del home
    RewriteRule ^libros/?$ /#libros [L,R=301]
</IfModule>

ErrorDocument 404 /404.php
